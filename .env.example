# Geoapify Geocoding API Key
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Firebase Configuration Override (Optional - fallback to hardcoded defaults in firebase_options.dart)
# Fill these out if you and your friend are using different Firebase projects/databases.
# FIREBASE_API_KEY=your_firebase_api_key_here
# FIREBASE_APP_ID=your_firebase_app_id_here
# FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
# FIREBASE_PROJECT_ID=your_project_id_here
# FIREBASE_DATABASE_URL=your_database_url_here
# FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
