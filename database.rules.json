{
  "rules": {
    ".read": false,
    ".write": false,

    "shop": {
      ".read": true,
      "$shopId": {
        ".write": "auth != null && (auth.uid === $shopId || data.child('ownerId').val() === auth.uid || newData.child('ownerId').val() === auth.uid)"
      }
    },

    "products": {
      ".read": true,
      "$shopId": {
        ".write": "auth != null && (auth.uid === $shopId || root.child('shop').child($shopId).child('ownerId').val() === auth.uid)"
      }
    },

    "offers": {
      ".read": true,
      "$shopId": {
        ".write": "auth != null && (auth.uid === $shopId || root.child('shop').child($shopId).child('ownerId').val() === auth.uid)",
        ".indexOn": ["createdAt"]
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$field": {
          ".write": "auth != null && auth.uid === $uid && $field !== 'roles'"
        },
        "roles": {
          ".write": false
        },
        "activeRole": {
          ".write": "auth != null && auth.uid === $uid && (newData.val() === 'customer' || newData.val() === 'merchant')"
        },
        "favorites": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "phones": {
      "$phone": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.phone_number === $phone && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid"
      }
    },

    "chats": {
      "$ownerId": {
        ".read": "auth != null && auth.uid === $ownerId",
        "$peerId": {
          ".write": "auth != null && auth.uid === $ownerId",
          "messages": {
            "$messageId": {
              ".write": "auth != null && (auth.uid === $ownerId || auth.uid === $peerId) && (!data.exists() && newData.exists() && newData.child('senderId').val() === auth.uid)"
            }
          },
          "lastMessage": {
            ".write": "auth != null && (auth.uid === $ownerId || auth.uid === $peerId) && ((auth.uid === $peerId && newData.child('senderId').val() === auth.uid && newData.child('unread').val() === true) || (auth.uid === $ownerId && newData.child('unread').val() === false))"
          },
          "vendorId": {
            ".write": "auth != null && (auth.uid === $ownerId || auth.uid === $peerId) && !data.exists()"
          },
          "customerId": {
            ".write": "auth != null && (auth.uid === $ownerId || auth.uid === $peerId) && !data.exists()"
          },
          "shopId": {
            ".write": "auth != null && (auth.uid === $ownerId || auth.uid === $peerId) && !data.exists()"
          },
          "shopName": {
            ".write": "auth != null && (auth.uid === $ownerId || auth.uid === $peerId)"
          },
          "shopLogo": {
            ".write": "auth != null && (auth.uid === $ownerId || auth.uid === $peerId)"
          },
          "userName": {
            ".write": "auth != null && (auth.uid === $ownerId || auth.uid === $peerId)"
          }
        }
      }
    },

    "users_devices": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "analytics": {
      "$vendorUid": {
        ".read": "auth != null && auth.uid === $vendorUid",
        "totals": {
          "views": {
            ".write": "auth != null && (!data.exists() && newData.val() === 1 || newData.val() === data.val() + 1)"
          },
          "clicks": {
            ".write": "auth != null && (!data.exists() && newData.val() === 1 || newData.val() === data.val() + 1)"
          }
        },
        "daily": {
          "$date": {
            "views": {
              ".write": "auth != null && (!data.exists() && newData.val() === 1 || newData.val() === data.val() + 1)"
            },
            "clicks": {
              ".write": "auth != null && (!data.exists() && newData.val() === 1 || newData.val() === data.val() + 1)"
            }
          }
        }
      }
    }
  }
}
