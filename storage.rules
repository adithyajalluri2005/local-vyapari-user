rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if the user has the merchant role
    function isMerchant() {
      return request.auth != null && 
             request.auth.token.roles != null && 
             request.auth.token.roles.merchant == true;
    }
    
    // Helper to check if the user is the owner of the shop in Firestore
    function isShopOwner(shopId) {
      return isMerchant() && 
             firestore.exists(/databases/$(database)/documents/searchable_shops/$(shopId)) &&
             firestore.get(/databases/$(database)/documents/searchable_shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // Public read access for all uploaded media assets
    match /{allPaths=**} {
      allow read: if true;
    }

    // Shop logos and banners
    match /shops/{shopId}/{filename} {
      // Allow writing if the user is the shop owner or if the shop document is not yet initialized
      allow write: if request.auth != null && isMerchant() && 
        (!firestore.exists(/databases/$(database)/documents/searchable_shops/$(shopId)) || 
         firestore.get(/databases/$(database)/documents/searchable_shops/$(shopId)).data.ownerId == request.auth.uid);
    }

    // Product images
    match /products/{shopId}/{productId}/{filename} {
      // Allow writing only if the user is the validated shop owner
      allow write: if request.auth != null && isShopOwner(shopId);
    }
  }
}
